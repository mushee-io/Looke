# Looke Ultra EVM-only (Testnet 18881) protected preview, not a public release.
# Ultra EVM Mainnet 19991 is read-only metadata, never enabled for token issuance or trading.
# Store these in host project environment settings; never commit real secrets.
NODE_ENV=production
LOOKE_PUBLIC_BETA_ENABLED=false
LOOKE_M6_EVIDENCE_ENABLED=false
LOOKE_SOCIAL_WRITES_ENABLED=false
LOOKE_M4_TRADING_ENABLED=false
LOOKE_M4_MARKETS_JSON=[]
ULTRA_EVM_RPC_URL=https://evm.test.ultra.eosusa.io

# Staging web origin — a real HTTPS hostname, protected from public access.
LOOKE_SOCIAL_APP_ORIGIN=https://staging.example.invalid
# Server-side DB credential from provider; no secret committed:
DATABASE_URL=

# M2 and M6 — independently verified on-chain receipts; leave empty until real evidence
LOOKE_FACTORY_ADDRESS=
LOOKE_FACTORY_DEPLOY_TX=
LOOKE_M6_FACTORY_RUNTIME_KECCAK=
LOOKE_M6_COIN_CREATION_TX=

# Review evidence: three signed-off GitHub PR/issue links and actual reviewer wallets.
# Must include walletAcceptance, securityReview, operationsApproval. Never invent these.
LOOKE_M6_ACCEPTANCE_JSON=

# A signed revision-bound, short-lived operator release message is required even after
# ALL checks pass. Do not set these to placeholders or simulate a release.
LOOKE_BETA_RELEASE_SIGNER=
LOOKE_BETA_RELEASE_REVISION=
LOOKE_BETA_RELEASE_EXPIRES_AT=
LOOKE_BETA_RELEASE_SIGNATURE=

# The actual Vercel immutable Git commit hash is resolved automatically where present.
# For self-managed deployments only, provide the EXACT deployed SHA:
LOOKE_M6_DEPLOY_REVISION=

# M2 frontend remains inactive until real deployment receipt has been verified.
NEXT_PUBLIC_LOOKE_FACTORY_ADDRESS=
NEXT_PUBLIC_LOOKE_FACTORY_DEPLOY_TX=
