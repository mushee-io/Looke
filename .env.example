# Ultra EVM Testnet RPC. Must resolve to chain 18881, not Ultra mainnet.
ULTRA_EVM_RPC_URL=https://evm.test.ultra.eosusa.io

# Optional, read-only: a public EVM address to check gas funding.
LOOKE_DEPLOYER_ADDRESS=

# Private CLI verification inputs. Set ONLY from a confirmed, operator-authorized deployment.
LOOKE_FACTORY_ADDRESS=
LOOKE_FACTORY_DEPLOY_TX=

# Public frontend inputs. Set ONLY after 'forge build && npm run m2:verify-factory' passes.
# Both are mandatory. A standalone address will NOT enable wallet execution.
NEXT_PUBLIC_LOOKE_FACTORY_ADDRESS=
NEXT_PUBLIC_LOOKE_FACTORY_DEPLOY_TX=

# Read-only creator transaction verification inputs (no keys)
LOOKE_COIN_TX=
# Optional strict expected result. If setting creator, set all four other fields.
LOOKE_EXPECTED_CREATOR=
LOOKE_EXPECTED_NAME=
LOOKE_EXPECTED_SYMBOL=
LOOKE_EXPECTED_METADATA_URI=
LOOKE_EXPECTED_SUPPLY_WEI=
