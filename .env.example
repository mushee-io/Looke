# Server-only PostgreSQL (TLS). Required for signed social accounts and event indexer.
DATABASE_URL=
# Secret of >= 24 characters, set only after deployed audited testnet factory is ready.
LOOKE_INDEXER_SECRET=
LOOKE_FACTORY_TESTNET_ADDRESS=
LOOKE_FACTORY_TESTNET_DEPLOY_BLOCK=
# Ultra NFT GraphQL credentials obtained from developers@ultra.io. Never use NEXT_PUBLIC prefix.
ULTRA_API_BEARER_TOKEN=
ULTRA_API_CLIENT_ID=
ULTRA_API_ENV=staging
# Build is testnet-first. Never use environment flags as permission to execute financial actions.
NEXT_PUBLIC_ULTRA_NETWORK=testnet
# M12: server-only, manually audited/verified Ultra EVM 18881 V2-compatible pools.
# Entries are configuration intent ONLY, not an audit attestation.
# Leave blank until source/bytecode, reserves, fee, router and token behaviors are independently verified.
LOOKE_ALLOWED_TESTNET_POOLS=
# Must match each configured pool's independently verified fee model. No live quote without it.
LOOKE_POOL_FEE_BPS=
# Keep native testnet mint lab hidden until permissions/security are verified.
NEXT_PUBLIC_LOOKE_UNIQ_MINT_LAB=false

# Server-only HMAC key for production auth/IP rate limiting, >=32 random characters.
# Required with migration db/003_auth_rate_limits.sql on Vercel production.
LOOKE_AUTH_RATE_SECRET=

# M9 read-only creator coin preflight reuses LOOKE_FACTORY_TESTNET_ADDRESS.
# No issuance/send-transaction feature flag exists; drafts never broadcast transactions.
