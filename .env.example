# Server-only PostgreSQL (TLS). Required for signed social accounts and event indexer.
DATABASE_URL=
# Secret of >= 24 characters, set only after deployed audited testnet factory is ready.
LOOKE_INDEXER_SECRET=
LOOKE_FACTORY_TESTNET_ADDRESS=
LOOKE_FACTORY_TESTNET_DEPLOY_BLOCK=
# Ultra NFT GraphQL credentials obtained from developers@ultra.io. Never use NEXT_PUBLIC prefix.
ULTRA_API_BEARER_TOKEN=
ULTRA_API_CLIENT_ID=
ULTRA_API_ENV=staging
# Build is testnet-first. Never use environment flags as permission to execute financial actions.
NEXT_PUBLIC_ULTRA_NETWORK=testnet
