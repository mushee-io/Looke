# Ultra EVM Testnet RPC. Must return chain ID 18881.
ULTRA_EVM_RPC_URL=https://evm.test.ultra.eosusa.io
LOOKE_DEPLOYER_ADDRESS=

# M2: Verified factory deployment proof (must be real and independently confirmed).
LOOKE_FACTORY_ADDRESS=
LOOKE_FACTORY_DEPLOY_TX=
NEXT_PUBLIC_LOOKE_FACTORY_ADDRESS=
NEXT_PUBLIC_LOOKE_FACTORY_DEPLOY_TX=
LOOKE_COIN_TX=
LOOKE_EXPECTED_CREATOR=
LOOKE_EXPECTED_NAME=
LOOKE_EXPECTED_SYMBOL=
LOOKE_EXPECTED_METADATA_URI=
LOOKE_EXPECTED_SUPPLY_WEI=

# M4: server-side verified, explicitly allowlisted Ultra EVM V2-compatible markets.
# Empty by default => read-only terminal and NO invented market.
# Each entry needs id, baseToken, quoteToken, factory, router, pair (all real 18881 contracts).
LOOKE_M4_MARKETS_JSON=[]
# Keep off until an independent review + real testnet LP/contract verification.
LOOKE_M4_TRADING_ENABLED=false

# M3 native Ultra Testnet RPC, chain-ID verified
ULTRA_NATIVE_TESTNET_RPC_URL=https://ultra-testnet.eosphere.io

# M5: Social API (server-only DB credentials, never NEXT_PUBLIC_*)
# PostgreSQL 15+. Apply migration explicitly with 'npm run db:migrate'.
DATABASE_URL=
# Must be the exact HTTPS origin of deployed Looke, without path/trailing slash.
LOOKE_SOCIAL_APP_ORIGIN=
# Default-off: no production posts, follows or authentication until DB/security acceptance.
LOOKE_SOCIAL_WRITES_ENABLED=false
# Optional comma-separated EVM addresses, wallet-signature identity still required.
LOOKE_SOCIAL_MODERATORS=

# M6 integrated staging: default CLOSED. Never turn public on with CI alone.
LOOKE_PUBLIC_BETA_ENABLED=false
# M6 read-only evidence RPC endpoint disabled until protected staging acceptance.
LOOKE_M6_EVIDENCE_ENABLED=false
# M6 live chain proof (server-only; no fabricated addresses or transaction hashes)
LOOKE_M6_FACTORY_RUNTIME_KECCAK=
LOOKE_M6_COIN_CREATION_TX=
LOOKE_M6_UNIQ_FACTORY_ID=
LOOKE_M6_UNIQ_OWNER=
LOOKE_M6_UNIQ_TOKEN_ID=
# M6 independently reviewed wallet acceptance, security and launch approvals.
LOOKE_M6_ACCEPTANCE_JSON=
# M6 revision-bound operator wallet approval, valid at most 24h.
LOOKE_BETA_RELEASE_SIGNER=
LOOKE_BETA_RELEASE_REVISION=
LOOKE_BETA_RELEASE_EXPIRES_AT=
LOOKE_BETA_RELEASE_SIGNATURE=
# Only for non-Vercel deployments; Vercel reads VERCEL_GIT_COMMIT_SHA instead.
LOOKE_M6_DEPLOY_REVISION=

# M7 staging monitors and acceptance: never add private keys or real passwords.
# M7 monitor endpoint /api/ops/monitor is read-only and returns 503 if dependencies are degraded.
# Default release/write/evidence flags from M6 must remain FALSE until acceptance.
# Vercel Deployment Protection must be confirmed independently in the hosting team.

# M8: read-only live Testnet evidence is collected in CI / operator machine, not a beta unlock.
# Only disposable localhost PostgreSQL may bypass transport TLS check in CI.
# NEVER set this to true for a remote or real staging database:
LOOKE_M8_ALLOW_LOCAL_PLAINTEXT_DB=false

# M9 read-only operator audit: provide VERCEL_TOKEN only in a secure local shell, never in Git.

# M10 read-only, server-only protected staging proof. The dedicated project
# does not exist until Vercel permissions are fixed; leave URL blank.
LOOKE_M10_STAGING_URL=
# Set VERCEL_TOKEN in authorized hosting/server secret settings ONLY,
# never as NEXT_PUBLIC, GitHub source or committed .env files.
# VERCEL_TOKEN=
# Second independently operated HTTPS Ultra Testnet RPCs (not placeholders).
# Without them the cross-check reports BLOCKED, not verified.
LOOKE_M10_SECONDARY_EVM_RPC_URL=
LOOKE_M10_SECONDARY_NATIVE_RPC_URL=
# All launch and transaction flags stay FALSE; M10 cannot open public beta.

# M11: genuine historical receipts are supplied separately as public JSON
# to npm run m11:acceptance -- ./public-testnet-receipts.json --strict
# No private keys or wallet signers are read by the acceptance script.
# Public beta, trading, social writes and evidence endpoint remain false.

# M13 real factory indexer (server-only). Omit until real wallet-authorized
# deployment and independent Ultra EVM 18881 receipt confirmation.
# LOOKE_M13_FACTORY_ADDRESS=
# LOOKE_M13_FACTORY_DEPLOY_TX=
# Do not use placeholders or fabricate trading volume and holder counts.
