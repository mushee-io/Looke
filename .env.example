# Server-only PostgreSQL (TLS). Required for signed social accounts and event indexer.
DATABASE_URL=
# Secret of >= 32 random characters; use only after audited testnet factory is authorized.
LOOKE_INDEXER_SECRET=
LOOKE_FACTORY_TESTNET_ADDRESS=
LOOKE_FACTORY_TESTNET_DEPLOY_BLOCK=
# Ultra NFT GraphQL credentials obtained from developers@ultra.io. Never use NEXT_PUBLIC prefix.
ULTRA_API_BEARER_TOKEN=
ULTRA_API_CLIENT_ID=
ULTRA_API_ENV=staging
# Build is testnet-first. Never use environment flags as permission to execute financial actions.
NEXT_PUBLIC_ULTRA_NETWORK=testnet
# M12: server-only, manually audited/verified Ultra EVM 18881 V2-compatible pools.
# Entries are configuration intent ONLY, not an audit attestation.
# Leave blank until source/bytecode, reserves, fee, router and token behaviors are independently verified.
LOOKE_ALLOWED_TESTNET_POOLS=
# Must match each configured pool's independently verified fee model. No live quote without it.
LOOKE_POOL_FEE_BPS=
# Keep native testnet mint lab hidden until permissions/security are verified.
NEXT_PUBLIC_LOOKE_UNIQ_MINT_LAB=false

# Server-only HMAC key for production auth/IP rate limiting, >=32 random characters.
# Required with migration db/003_auth_rate_limits.sql on Vercel production.
LOOKE_AUTH_RATE_SECRET=

# M9 read-only creator coin preflight reuses LOOKE_FACTORY_TESTNET_ADDRESS.
# No issuance/send-transaction feature flag exists; drafts never broadcast transactions.

# M13 source indexing: must be a trusted block at/before the earliest relevant
# allowed pool event. This is not permission to trade or automatically mint.
LOOKE_MARKET_POOL_START_BLOCK=
# Protected scheduler calls /api/indexer with LOOKE_INDEXER_SECRET.
# Do not activate before independent contract/pool verification and staging QA.

# M18 read-only EVM portfolio: maximum 8 unique, independently reviewed
# Ultra EVM 18881 ERC-20 contract addresses, separated by commas.
# No configured tokens means no ERC-20 holdings/history coverage, NOT zero assets.
# Keep server-only. Do not treat the allowlist as proof of independent audit.
LOOKE_PORTFOLIO_TOKEN_ALLOWLIST=
# M20 operator-only health monitoring credential, different from indexer secret.
# Each token must be at least 32 random characters. Never expose to browser.
LOOKE_INDEXER_MONITOR_SECRET=
# GitHub Actions-only (NOT Vercel or NEXT_PUBLIC):
# - Actions Variable LOOKE_INDEXER_SCHEDULER_ENABLED='true' is explicit activation.
# - Actions Secret LOOKE_SCHEDULER_BASE_URL is approved HTTPS staging origin.
# - Actions Secret LOOKE_INDEXER_SECRET matches deployed worker bearer.
# - Actions Secret LOOKE_INDEXER_MONITOR_SECRET (optional) matches monitor bearer.
# - Actions Variable LOOKE_APPROVED_INDEXER_POOLS (optional) is reviewed comma list.
# Read docs/M20-INDEXER_OPERATIONS.md before any activation.

# M21 operator-only read-only two-RPC receipt corroboration.
# This must be a separately configured, independently reviewed public HTTPS
# Ultra EVM TESTNET 18881 RPC (different host from documented primary).
# Blank by default: the verifier fails closed and issues NO evidence.
# Never expose under NEXT_PUBLIC or provide a user-entered RPC URL.
LOOKE_INDEPENDENT_EVM_TESTNET_RPC=
