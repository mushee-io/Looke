pragma solidity ^0.8.24;

import {LookeCoinFactory} from "../contracts/LookeCoinFactory.sol";

/// @notice Minimal Foundry cheatcode interface; no forge-std dependency required.
interface VmBroadcast {
    function startBroadcast() external;
    function stopBroadcast() external;
}

/// @notice Deploys only on Ultra EVM Testnet. Simulation is the default.
/// @dev An actual deployment requires an operator-selected Foundry signer and explicit --broadcast.
/// No private keys are embedded, fetched, or generated by this script.
contract DeployLookeCoinFactory {
    VmBroadcast private constant vm = VmBroadcast(address(uint160(uint256(keccak256("hevm cheat code")))));

    function run() external returns (LookeCoinFactory factory) {
        require(block.chainid == 18881, "Ultra EVM Testnet only (18881)");
        vm.startBroadcast();
        factory = new LookeCoinFactory();
        vm.stopBroadcast();
    }
}
